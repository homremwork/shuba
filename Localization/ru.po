msgstr "Импортировать ZIP резервной копии"

msgctxt "recovery.action.show_technical"
msgid "Show technical report"
msgstr "Показать технический отчёт"

msgctxt "recovery.action.continue_accepted"
msgid "Continue using accepted records"
msgstr "Продолжить работу с принятыми записями"

msgctxt "recovery.action.retry_normal"
msgid "Retry normal launch"
msgstr "Повторить обычный запуск"

msgctxt "recovery.action.exit"
msgid "Exit"
msgstr "Выйти"

msgctxt "recovery.counts"
msgid ""
"Accepted: items={accepted_items} · storages={accepted_storages} · "
